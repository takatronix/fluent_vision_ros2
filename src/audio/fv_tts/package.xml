<?xml version="1.0"?>
<package format="3">
  <name>fv_tts</name>
  <version>0.2.0</version>
  <description>Native voicevox_core ROS 2 TTS for ASPA dialogue.</description>
  <maintainer email="info@vegetalia.co.jp">ASPA Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>fluent_dialogue_dora_interfaces</build_depend>
  <exec_depend>fluent_dialogue_dora_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
