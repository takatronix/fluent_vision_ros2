<?xml version="1.0"?>
<package format="3">
  <name>aspa_audio</name>
  <version>0.1.0</version>
  <description>ASPA CPAL audio capture/output and single playback controller.</description>
  <maintainer email="info@vegetalia.co.jp">ASPA Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>fluent_dialogue_dora_interfaces</build_depend>
  <build_depend>std_msgs</build_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>fluent_dialogue_dora_interfaces</exec_depend>
  <exec_depend>python3-gi</exec_depend>
  <exec_depend>gstreamer1.0-plugins-base</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
