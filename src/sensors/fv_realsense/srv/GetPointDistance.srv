# Request
int32 x                    # Pixel X coordinate
int32 y                    # Pixel Y coordinate
int32 mode                 # 0: no display, 1: cursor only, 2: cursor + XYZ (10s)

---
# Response
bool success               # Success status
float64 x                  # 3D X coordinate (meters)
float64 y                  # 3D Y coordinate (meters)
float64 z                  # 3D Z coordinate (meters)
string message             # Status message
string frame_id            # Frame ID of the result


