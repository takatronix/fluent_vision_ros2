#!/usr/bin/env bash

set -euo pipefail

REPOSITORY_URL="https://github.com/OpenMOSS/MOSS-VL.git"
REVISION="${MOSS_VL_REVISION:-5cf6753156df2c8e7f38e36b55d28687e1df425e}"
DESTINATION="${MOSS_VL_REPO:-/opt/MOSS-VL}"

if [[ -e "${DESTINATION}" ]]; then
  echo "Destination already exists: ${DESTINATION}" >&2
  exit 2
fi

git clone --filter=blob:none "${REPOSITORY_URL}" "${DESTINATION}"
git -C "${DESTINATION}" checkout --detach "${REVISION}"

cat <<EOF
Pinned MOSS-VL source prepared at ${DESTINATION}
Install its official requirements in the dedicated MOSS runtime environment:
  python3.12 -m pip install --no-build-isolation -r ${DESTINATION}/requirements.txt
Then run:
  scripts/start_moss_vl_realtime --preflight-only
EOF
