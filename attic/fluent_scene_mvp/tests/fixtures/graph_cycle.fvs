schema: fluent.scene/v1alpha1
kind: Scene
metadata:
  name: graph_cycle_fixture
nodes:
  - id: camera_layer
    type: visual.image2d
    inputs:
      image: $nodes.composite.image
  - id: composite
    type: composite.layers
    inputs:
      layers:
        - $nodes.camera_layer.layer
outputs:
  frame:
    type: image.rgba8
    source: $nodes.composite.image
budgets:
  max_width: 1920
  max_height: 1080
  max_gpu_bytes: 268435456
  max_upload_bytes_per_frame: 33554432
  max_frames_in_flight: 2
