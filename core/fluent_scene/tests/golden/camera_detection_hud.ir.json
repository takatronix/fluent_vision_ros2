{
  "schema": "fluent.scene/v1alpha1",
  "kind": "Scene",
  "metadata": {
    "name": "camera_detection_hud"
  },
  "params": [
    {
      "name": "accent_color",
      "type": "vec4f",
      "runtime_mutable": true,
      "default": [
        0.1,
        0.9,
        0.7,
        1
      ]
    }
  ],
  "types": [
    {
      "name": "Detection2D",
      "fields": [
        {
          "name": "bbox",
          "type": "vec4f"
        },
        {
          "name": "score",
          "type": "f32"
        },
        {
          "name": "label",
          "type": "string"
        }
      ]
    }
  ],
  "inputs": [
    {
      "name": "camera",
      "type": "image.rgba8",
      "required": true,
      "update": "per_frame",
      "metadata": {
        "calibration": "camera_calibration",
        "clock": "required",
        "frame": "required",
        "synchronization_group": "sensor_frame",
        "timestamp": "required"
      },
      "fallback": "no_frame"
    },
    {
      "name": "camera_calibration",
      "type": "calibration",
      "required": true,
      "update": "on_change",
      "fallback": "no_frame"
    },
    {
      "name": "depth",
      "type": "image.depth32f",
      "required": false,
      "update": "per_frame",
      "metadata": {
        "calibration": "camera_calibration",
        "clock": "required",
        "depth": "required",
        "frame": "required",
        "synchronization_group": "sensor_frame",
        "timestamp": "required"
      },
      "fallback": "hide_depth"
    },
    {
      "name": "detections",
      "type": "sequence<Detection2D,128>",
      "required": false,
      "update": "per_frame",
      "metadata": {
        "clock": "required",
        "frame": "required",
        "synchronization_group": "sensor_frame",
        "timestamp": "required"
      },
      "fallback": "empty_detections"
    },
    {
      "name": "status_text",
      "type": "string",
      "required": false,
      "update": "on_change",
      "constraints": {
        "max_utf8_bytes": 256
      },
      "fallback": "default_status"
    }
  ],
  "resources": [
    {
      "name": "ui_font",
      "type": "font",
      "uri": "builtin://fonts/default-cjk",
      "glyph_capacity": 2048
    }
  ],
  "nodes": [
    {
      "id": "camera_layer",
      "type": "visual.image2d",
      "inputs": [
        {
          "port": "image",
          "source": {
            "ref": "$inputs.camera"
          }
        }
      ],
      "params": [
        {
          "name": "fit",
          "value": "contain"
        }
      ]
    },
    {
      "id": "detection_layer",
      "type": "visual.boxes2d",
      "inputs": [
        {
          "port": "detections",
          "source": {
            "ref": "$inputs.detections"
          }
        }
      ],
      "params": [
        {
          "name": "color",
          "value": {
            "ref": "$params.accent_color"
          }
        },
        {
          "name": "show_label",
          "value": true
        },
        {
          "name": "smoothing",
          "value": 0
        }
      ],
      "bounds": {
        "max_instances": 128,
        "overflow": "drop_lowest_score"
      }
    },
    {
      "id": "status_layer",
      "type": "text.dynamic",
      "inputs": [
        {
          "port": "text",
          "source": {
            "ref": "$inputs.status_text"
          }
        }
      ],
      "params": [
        {
          "name": "color",
          "value": [
            1,
            1,
            1,
            1
          ]
        },
        {
          "name": "default_text",
          "value": "映像を待っています"
        },
        {
          "name": "font",
          "value": {
            "ref": "$resources.ui_font"
          }
        },
        {
          "name": "position",
          "value": [
            24,
            24
          ]
        },
        {
          "name": "shadow",
          "value": true
        }
      ],
      "bounds": {
        "max_glyphs": 128,
        "overflow": "truncate_end"
      }
    },
    {
      "id": "composite",
      "type": "composite.layers",
      "inputs": [
        {
          "port": "layers",
          "source": [
            {
              "ref": "$nodes.camera_layer.layer"
            },
            {
              "ref": "$nodes.detection_layer.layer"
            },
            {
              "ref": "$nodes.status_layer.layer"
            }
          ]
        }
      ],
      "params": [
        {
          "name": "color_space",
          "value": "srgb"
        }
      ]
    }
  ],
  "outputs": [
    {
      "name": "diagnostics",
      "type": "diagnostic_set",
      "source": {
        "ref": "$runtime.diagnostics"
      }
    },
    {
      "name": "frame",
      "type": "image.rgba8",
      "source": {
        "ref": "$nodes.composite.image"
      }
    }
  ],
  "budgets": {
    "max_frames_in_flight": 2,
    "max_gpu_bytes": 268435456,
    "max_height": 1080,
    "max_upload_bytes_per_frame": 33554432,
    "max_width": 1920
  },
  "fallbacks": [
    {
      "name": "default_status",
      "value": "映像を待っています"
    },
    {
      "name": "empty_detections",
      "value": []
    },
    {
      "name": "hide_depth",
      "value": null
    },
    {
      "name": "no_frame",
      "behavior": "output_unavailable"
    }
  ]
}
