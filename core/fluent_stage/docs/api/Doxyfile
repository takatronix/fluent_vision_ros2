QUIET                  = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HAVE_DOT               = YES
CALL_GRAPH             = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
IMAGE_PATH             = docs/images
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = include
