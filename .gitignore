# ROS2 build artifacts
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.serena/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Test coverage
.coverage
coverage.xml
htmlcov/

# Documentation build
docs/build/
docs/_build/

# Cache
.cache/
.pytest_cache/

# Config files with sensitive data
.env
.env.local
config/secrets.yaml

# Large model files (download via hf or scripts)
models/depth_anything_v3/*.onnx
models/depth_anything_v3/*.onnx_data
models/depth_anything_v3/*.safetensors
models/depth_anything_v3/DA3-SMALL/
models/depth_anything_v3/onnx-community-small/
models/depth_anything_v3/DA3METRIC-LARGE.onnx
# Training-source weights / per-export dups live under models/yolo/; the
# runtime/engine-build copy is the committed models/onnx/*.onnx (cube precedent).
models/yolo/*.pt
models/yolo/*.onnx

# TensorRT generated artifacts (GPU SM / TRT version specific binary;
# rebuild per host from the committed .onnx via entrypoint trtexec).
models/tensorrt/*.engine
models/tensorrt/*.timing.cache
models/tensorrt/*.timing.cache.lock
*.engine
*.timing.cache